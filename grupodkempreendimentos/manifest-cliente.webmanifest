{
  "name": "DK Locadora — Área do Cliente",
  "short_name": "DK Cliente",
  "description": "Consulte seus contratos e envie comprovantes de pagamento à DK Locadora.",
  "id": "/cliente",
  "start_url": "/cliente",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0c0f14",
  "theme_color": "#c9a227",
  "lang": "pt-BR",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "icons/icon-cliente-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "icons/icon-cliente-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/cliente",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": ["image/*", "application/pdf", ".pdf"]
        }
      ]
    }
  },
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}
