{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd .. && npm install",
  "buildCommand": "cd .. && node scripts/copy-portal-for-vercel.cjs",
  "outputDirectory": "../.vercel-portal-dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/openai-comprovante.js": { "maxDuration": 60 },
    "api/openai-extrato.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/instalar", "destination": "/instalar.html" },
    { "source": "/grupodk", "destination": "/grupodk.html" },
    { "source": "/GRUPODK", "destination": "/grupodk.html" },
    { "source": "/dklocadora", "destination": "/dklocadora.html" },
    { "source": "/DKLOCADORA", "destination": "/dklocadora.html" },
    { "source": "/dkcentroautomotivo", "destination": "/dkcentroautomotivo.html" },
    { "source": "/DKCENTROAUTOMOTIVO", "destination": "/dkcentroautomotivo.html" },
    { "source": "/dkconstrutora", "destination": "/dkconstrutora.html" },
    { "source": "/DKCONSTRUTORA", "destination": "/dkconstrutora.html" }
  ],
  "crons": [
    {
      "path": "/api/cron-daily-backup",
      "schedule": "0 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
    },
    {
      "source": "/manifest-corporativo.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/manifest-locadora.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/manifest-centro.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/manifest-construtora.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/manifest-cliente.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/service-worker-corporativo.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/service-worker-cliente.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ]
}
