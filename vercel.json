{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/copy-portal-for-vercel.cjs",
  "outputDirectory": ".vercel-portal-dist",
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "env": {
    "DK_BACKUP_EMAIL_TO": "marciogarn@gmail.com",
    "DK_BACKUP_EMAIL_FROM": "Grupo DK Backup <marciogarn@gmail.com>",
    "SUPABASE_URL": "https://ppxtwqvzgujllfzarpuz.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_Nm-Et1yeL66vgoA2rqD__w_CLtGauk3"
  },
  "rewrites": [
    { "source": "/instalar", "destination": "/instalar.html" },
    { "source": "/grupodk", "destination": "/grupodk.html" },
    { "source": "/GRUPODK", "destination": "/grupodk.html" },
    { "source": "/dklocadora", "destination": "/dklocadora.html" },
    { "source": "/DKLOCADORA", "destination": "/dklocadora.html" },
    { "source": "/dkcentroautomotivo", "destination": "/dkcentroautomotivo.html" },
    { "source": "/DKCENTROAUTOMOTIVO", "destination": "/dkcentroautomotivo.html" },
    { "source": "/dkconstrutora", "destination": "/dkconstrutora.html" },
    { "source": "/DKCONSTRUTORA", "destination": "/dkconstrutora.html" }
  ],
  "crons": [
    {
      "path": "/api/cron-daily-backup",
      "schedule": "0 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
    },
    {
      "source": "/:path*.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/manifest-cliente.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/service-worker-cliente.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/instalar",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/instalar.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
